        <mxCell id="title" value="CFI 架构总览：CPU + 内存故障隔离 (CFI + MFI)" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
